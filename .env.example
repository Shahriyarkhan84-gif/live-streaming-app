# =============================================================================
# LiveStream Platform — environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.
# All external services default to local/mock so the app runs with no keys.
# =============================================================================

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://livestream:livestream@localhost:5432/livestream?schema=public

# --- Auth.js / NextAuth v5 (Phase 2) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Realtime chat service (Phase 8) ---
REALTIME_PORT=4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
REDIS_URL=redis://localhost:6379

# --- Streaming provider (Phase 4/7) ---
# 'mock' runs a local fake so no external video service is needed.
# Real providers (livepeer|mux|cloudflare) add their own keys below later.
STREAMING_PROVIDER=mock
# LIVEPEER_API_KEY=
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# --- Payments provider (Phase 12) ---
# 'mock' runs a local fake so no Stripe account is required in dev.
PAYMENTS_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
