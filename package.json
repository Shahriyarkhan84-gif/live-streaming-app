{
  "name": "livestream-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready live streaming platform (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @livestream/database db:generate",
    "db:migrate": "pnpm --filter @livestream/database db:migrate",
    "db:studio": "pnpm --filter @livestream/database db:studio",
    "db:seed": "pnpm --filter @livestream/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
